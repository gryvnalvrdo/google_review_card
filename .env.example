# Password untuk login ke /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# String acak panjang untuk menandatangani cookie session admin
# Generate contoh: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Diisi OTOMATIS oleh Vercel saat kamu connect Vercel KV / Upstash Redis
# ke project ini. Jangan isi manual kecuali tahu nilainya.
KV_REST_API_URL=
KV_REST_API_TOKEN=
